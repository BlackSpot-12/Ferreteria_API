# Copy this file to .env and replace values for your environment.
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=ferreteria

# Generate a random secret with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY_TOKEN=

# Comma-separated Flutter Web origins. Add the exact production HTTPS origin.
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# Required only when running the demo seeder.
SEED_OWNER_PASSWORD=
SEED_EMPLOYEE_PASSWORD=
SEED_CUSTOMER_PASSWORD=

# Optional issuer fields used by invoice generation.
FACTURA_RAZON_SOCIAL=
FACTURA_IDENTIFICACION=
FACTURA_DIRECCION=
FACTURA_TELEFONO=
